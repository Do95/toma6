<h1 class="auth-title">Panel de administración</h1>
<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
  <div class="field">
    <%= f.label :email, "Correo" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %>
  </div>
  <div class="field">
    <%= f.label :password, "Contraseña" %>
    <%= f.password_field :password, autocomplete: "current-password", required: true %>
  </div>
  <label class="check-inline"><%= f.check_box :remember_me %> Mantener la sesión abierta</label>
  <button type="submit" class="btn btn-primary btn-block">Ingresar</button>
<% end %>
<p class="auth-alt"><%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name) %></p>
