<% if @invited %>
  <h1 class="auth-title">¡Hola, <%= @invited.name.to_s.split.first %>!</h1>
  <p class="auth-lead">
    Te damos la bienvenida a <%= settings.site_name %>. Tu cuenta ya está lista con el rol de <strong><%= @invited.role_label %></strong>;
    solo falta que elijas una contraseña.
  </p>
  <p class="auth-lead" style="font-size:13.5px">Vas a entrar con <strong><%= @invited.email %></strong>.</p>
  <% if @invited.invitation_expired? %>
    <p class="auth-flash auth-flash-alert">Esta invitación ya venció. Pedí que te envíen una nueva y vas a poder entrar sin problema.</p>
  <% end %>
<% else %>
  <h1 class="auth-title">Nueva contraseña</h1>
<% end %>
<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>
  <div class="field">
    <%= f.label :password, @invited ? "Elegí tu contraseña" : "Contraseña nueva" %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true %>
    <p class="hint">Mínimo <%= @minimum_password_length || 8 %> caracteres.</p>
  </div>
  <div class="field">
    <%= f.label :password_confirmation, "Repetila" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true %>
  </div>
  <button type="submit" class="btn btn-primary btn-block"><%= @invited ? "Crear contraseña y empezar" : "Guardar contraseña" %></button>
<% end %>
