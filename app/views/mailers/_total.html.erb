<% font = MailerHelper::FONT %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:14px">
  <tr><td bgcolor="#171717" style="background:#171717;border-radius:6px;border-left:5px solid <%= MailerHelper::RED %>;padding:14px 18px">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
      <td style="font-family:<%= font %>;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#bdb8b1"><%= label %></td>
      <td align="right" style="font-family:<%= font %>;font-size:22px;font-weight:bold;color:#ffffff;white-space:nowrap"><%= value %></td>
    </tr></table>
  </td></tr>
</table>
