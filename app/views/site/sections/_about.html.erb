<section class="section about" id="<%= section.anchor %>" aria-labelledby="t-<%= section.anchor %>">
  <div class="wrap about-grid">
    <div class="about-head">
      <h2 id="t-<%= section.anchor %>"><%= section.title %></h2>
      <% if section.lead.present? %><p class="about-lead"><%= inline_text(section.lead) %></p><% end %>
    </div>
    <div class="about-body">
      <%= rich_text(section.body) %>
      <% if @values.present? %>
        <ul class="values"><% @values.each do |value| %><li><strong><%= value.title %></strong><span><%= value.description %></span></li><% end %></ul>
      <% end %>
      <% if section.note.present? %><p class="about-close"><%= inline_text(section.note) %></p><% end %>
    </div>
  </div>
</section>
