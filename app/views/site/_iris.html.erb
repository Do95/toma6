<%# Lente de cine del hero. Lo anima hero_controller.js (apertura, foco y escala de f);
    lo que se dibuja acá es el estado final, por si no hay JavaScript o se pidió reducir movimiento. %>
<svg class="iris" viewBox="0 0 600 600" aria-hidden="true">
  <defs>
    <radialGradient id="irisLight" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#d9473d" stop-opacity=".42"/>
      <stop offset=".55" stop-color="#b63830" stop-opacity=".12"/>
      <stop offset="1" stop-color="#b63830" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="irisBlade" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1c1c1c"/>
      <stop offset=".55" stop-color="#0e0e0e"/>
      <stop offset="1" stop-color="#151515"/>
    </linearGradient>
    <radialGradient id="irisSheen" cx="32%" cy="26%" r="60%">
      <stop offset="0" stop-color="#fff" stop-opacity=".09"/>
      <stop offset="1" stop-color="#fff" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="irisCoating" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#8f6bff" stop-opacity="0"/>
      <stop offset=".5" stop-color="#8f6bff" stop-opacity=".16"/>
      <stop offset="1" stop-color="#3fd6a8" stop-opacity="0"/>
    </linearGradient>
    <clipPath id="irisClip"><circle cx="300" cy="300" r="<%= IrisHelper::IRIS[:clip] %>"/></clipPath>
  </defs>

  <%# Vidrio: fondo oscuro y la luz roja que entra por la apertura %>
  <circle cx="300" cy="300" r="<%= IrisHelper::IRIS[:clip] %>" fill="#080808"/>
  <circle class="iris-light" cx="300" cy="300" r="190" fill="url(#irisLight)"/>

  <%# Diafragma %>
  <g clip-path="url(#irisClip)">
    <g class="iris-leaves">
      <% blades = iris_blades(1) %>
      <% blades.each do |b| %><path class="iris-leaf" d="<%= b[:fill] %>" fill="url(#irisBlade)"/><% end %>
      <% blades.each do |b| %><path class="iris-edge" d="<%= b[:edge] %>" fill="none" stroke="#fff" stroke-opacity=".16" stroke-width="1.1"/><% end %>
      <polygon class="iris-aperture" points="<%= iris_aperture_points(1) %>" fill="none" stroke="#e0473b" stroke-opacity=".55" stroke-width="1.4" stroke-linejoin="round"/>
    </g>
    <circle cx="300" cy="300" r="<%= IrisHelper::IRIS[:clip] %>" fill="url(#irisSheen)"/>
    <ellipse class="iris-coating" cx="186" cy="196" rx="74" ry="20" transform="rotate(-42 186 196)" fill="url(#irisCoating)" opacity=".8"/>
  </g>

  <%# Barril y aro frontal %>
  <circle cx="300" cy="300" r="202" fill="none" stroke="#fff" stroke-opacity=".07" stroke-width="12"/>
  <circle cx="300" cy="300" r="212" fill="none" stroke="#fff" stroke-opacity=".22"/>

  <%# Anillo de foco (distancia) %>
  <g class="iris-focus" data-hero-target="focusRing">
    <% (-80..80).step(4) do |deg| %>
      <% x1, y1 = iris_point(236, deg); x2, y2 = iris_point(241, deg) %><line x1="<%= x1 %>" y1="<%= y1 %>" x2="<%= x2 %>" y2="<%= y2 %>" stroke="#fff" stroke-opacity=".22"/>
    <% end %>
    <g fill="#fff" fill-opacity=".62" font-size="10.5" font-family="Archivo, Helvetica, Arial, sans-serif" font-weight="600" letter-spacing=".5" text-anchor="middle" dominant-baseline="middle">
      <% IrisHelper::IRIS[:distances].each do |label, deg| %>
        <% x, y = iris_point(225, deg) %><text x="<%= x %>" y="<%= y %>" transform="rotate(<%= deg %> <%= x %> <%= y %>)"><%= label %></text>
      <% end %>
      <% x, y = iris_point(225, 80) %><text x="<%= x %>" y="<%= y %>" transform="rotate(80 <%= x %> <%= y %>)" fill-opacity=".4" font-size="9">m</text>
    </g>
  </g>

  <%# Profundidad de campo: el arco se abre al cerrar el diafragma %>
  <path class="iris-dof" data-hero-target="dof" d="<%= iris_dof_arc(1) %>" fill="none" stroke="#e0473b" stroke-width="3" stroke-linecap="round"/>

  <%# Anillo de diafragma (números f) %>
  <g class="iris-fring" data-hero-target="fRing" style="transform:rotate(30deg)">
    <% (0...360).step(3) do |deg| %>
      <% major = (deg % 15).zero? && deg.between?(0, 60) || (deg % 15).zero? && deg >= 300 %>
      <% x1, y1 = iris_point(major ? 266 : 272, deg); x2, y2 = iris_point(281, deg) %><line x1="<%= x1 %>" y1="<%= y1 %>" x2="<%= x2 %>" y2="<%= y2 %>" stroke="#fff" stroke-opacity="<%= major ? '.55' : '.2' %>" stroke-width="<%= major ? 1.4 : 1 %>"/>
    <% end %>
    <g fill="#fff" fill-opacity=".58" font-size="11" font-family="Archivo, Helvetica, Arial, sans-serif" font-weight="600" letter-spacing="1" text-anchor="middle" dominant-baseline="middle">
      <% IrisHelper::IRIS[:f_stops].each_with_index do |label, i| %>
        <% deg = (i - 4) * IrisHelper::IRIS[:f_step]; x, y = iris_point(254, deg) %><text x="<%= x %>" y="<%= y %>" transform="rotate(<%= deg %> <%= x %> <%= y %>)"><%= label %></text>
      <% end %>
    </g>
  </g>
  <circle cx="300" cy="300" r="292" fill="none" stroke="#fff" stroke-opacity=".12"/>

  <%# Marca índice %>
  <path d="M300 18 l-6 -11 h12 z" fill="#e0473b"/>
</svg>
