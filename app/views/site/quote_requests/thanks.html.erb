<% content_for :title, page_title("Solicitud enviada") %>
<% content_for :robots, "noindex" %>
<section class="thanks">
  <div class="thanks-card">
    <div class="clapper" aria-hidden="true"><span></span></div>
    <h1>¡Corte! Recibimos tu solicitud.</h1>
    <% if @quote_request %>
      <p class="thanks-number">Solicitud N.º <strong><%= @quote_request.number %></strong></p>
      <p>Gracias, <%= @quote_request.name.split.first %>. Te escribimos a <strong><%= @quote_request.email %></strong> con una propuesta cerrada.</p>
      <% prices = settings.estimator_shows_prices? %>
      <% plan_line = @quote_request.plan_line %>
      <div class="thanks-summary">
        <ul>
          <% @quote_request.selection_lines.each do |line| %>
            <li><span><%= line["label"] %><% if line["quantity"].to_i > 1 %> × <%= line["quantity"] %><% end %></span><% if prices || line.equal?(plan_line) %><span><%= line["total"].to_d.positive? ? money(line["total"]) : "Incluido" %></span><% end %></li>
          <% end %>
        </ul>
        <% if prices %>
          <% if @quote_request.discount.positive? %><p class="thanks-discount">Combo de servicios: −<%= money(@quote_request.discount) %></p><% end %>
          <p class="thanks-total">Total estimado <strong><%= money(@quote_request.estimated_total) %></strong></p>
        <% elsif plan_line %>
          <p class="thanks-total"><%= @quote_request.priced_extras? ? "Desde" : "Total" %> <strong><%= money(plan_line["total"]) %></strong></p>
          <% if @quote_request.priced_extras? %><p class="thanks-discount">El precio de lo que sumaste al plan va en tu propuesta.</p><% end %>
        <% end %>
      </div>
    <% else %>
      <p>Te respondemos rápido con una propuesta.</p>
    <% end %>
    <div class="hero-cta">
      <%= link_to "Ver trabajos", projects_path, class: "btn primary" %>
      <% if settings.whatsapp_url %><a class="link" href="<%= settings.whatsapp_url %>" target="_blank" rel="noopener">Escribir por WhatsApp ›</a><% end %>
    </div>
  </div>
</section>
