<% content_for :title, "Servicios" %>
<%= render "admin/shared/header", title: "Servicios",
           subtitle: "Las tarjetas del sitio y los precios del cotizador. Arrastrá para cambiar el orden.",
           actions: (link_to(safe_join([icon(:plus, size: 16), "Nuevo servicio"]), new_admin_service_path, class: "btn btn-primary") if can?(:content, :write)) %>
<div class="card">
  <% if @records.any? %>
    <ul class="sort-list" <% if can?(:content, :write) %>data-controller="sortable" data-sortable-model-value="services" data-sortable-url-value="<%= admin_sort_path %>"<% end %>>
      <% @records.each_with_index do |service, i| %>
        <li class="sort-item <%= row_class(service) %>" data-id="<%= service.id %>">
          <span class="sort-handle"><%= icon(:grip, size: 18) %></span>
          <% if service.image.present? %><%= image_tag service.image.url(:thumb), class: "sort-thumb", alt: "" %><% else %><span class="sort-thumb"><%= illustration("fotos") %></span><% end %>
          <div class="sort-main">
            <%= link_to edit_admin_service_path(service) do %><strong><%= service.title %></strong><% end %>
            <p>
              <% if service.quotable? %><%= service.price_prefix %> <%= money(service.base_price, round: true) %> · <%= pluralize(service.options.size, "opción", plural: "opciones") %> en el cotizador<% else %>No aparece en el cotizador<% end %>
            </p>
          </div>
          <div class="sort-meta">
            <%= row_actions(service) %>
            <%= audit_line(service) %>
            <%= link_to icon(:edit, size: 16, title: "Editar"), edit_admin_service_path(service), class: "icon-btn" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= render "admin/shared/empty", title: "Todavía no hay servicios", text: "Cada servicio es una tarjeta del sitio y una opción del cotizador.",
               action: link_to("Crear el primero", new_admin_service_path, class: "btn btn-primary") %>
  <% end %>
</div>
