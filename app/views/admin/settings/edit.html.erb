<% content_for :title, "Ajustes" %>
<%= render "admin/shared/header", title: "Ajustes", subtitle: "Cotizaciones, impuestos, PDF y papelera. Solo los administradores pueden cambiarlos." %>
<%= form_with model: @setting, url: admin_settings_path, method: :patch, html: { multipart: true } do |f| %>
  <%= form_errors(@setting) %>
  <div class="grid-2">
    <div class="card">
      <div class="card-head"><div><h2>Moneda e impuestos</h2></div></div>
      <div class="card-body form-grid">
        <div class="field"><%= f.label :currency_symbol, "Símbolo" %><%= f.text_field :currency_symbol %></div>
        <div class="field"><%= f.label :currency_code, "Código" %><%= f.text_field :currency_code %></div>
        <div class="field"><%= f.label :tax_name, "Nombre del impuesto" %><%= f.text_field :tax_name %></div>
        <div class="field"><%= f.label :tax_rate, "Tasa (%)" %><%= f.number_field :tax_rate, step: "0.01" %></div>
        <div class="span-2"><%= switch_field(f, :estimator_shows_tax, "Sumar el impuesto en el cotizador web", "Si está apagado, el estimado se muestra sin impuesto.") %></div>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><div><h2>Cotizador web</h2></div></div>
      <div class="card-body form-grid">
        <div class="span-2"><%= switch_field(f, :estimator_shows_prices, "Mostrar el precio de los servicios en el cotizador web",
                                             "Si lo apagás, los planes siguen mostrando su precio, pero los servicios y extras no (ni en el sitio ni en el correo del cliente). Vos recibís la solicitud con el estimado completo.") %>
          <p class="hint" style="margin:8px 0 0 52px">Si cambiás esto, revisá que el <%= link_to "título y texto del cotizador", edit_admin_site_content_path(tab: "cotizador") %> no hablen de precios.</p></div>
        <div class="field"><%= f.label :bundle_discount_percent, "Descuento por combinar (%)" %><%= f.number_field :bundle_discount_percent, step: "0.5", min: 0 %><%= field_hint("0 = sin descuento.") %></div>
        <div class="field"><%= f.label :bundle_min_services, "A partir de cuántos servicios" %><%= f.number_field :bundle_min_services, min: 2 %></div>
        <div class="field span-2"><%= f.label :estimator_disclaimer, "Aclaración debajo del total" %><%= f.text_area :estimator_disclaimer, rows: 2 %></div>
        <div class="field span-2"><%= f.label :notification_email, "Avisar solicitudes nuevas a" %><%= f.email_field :notification_email, placeholder: settings.contact_email %></div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><div><h2>Cotizaciones y PDF</h2><p>Valores que se cargan en cada cotización nueva.</p></div>
      <% if (sample = Quote.kept.recent.first) %><%= link_to safe_join([icon(:file, size: 16), "Ver un PDF de ejemplo"]), pdf_admin_quote_path(sample), class: "btn btn-sm", target: "_blank" %><% end %>
    </div>
    <div class="card-body form-grid">
      <div class="span-2 numbering" data-controller="number-preview">
        <p class="label" style="margin:0 0 10px">Numeración automática</p>
        <div class="form-grid" style="grid-template-columns:repeat(4,1fr)">
          <div class="field"><%= f.label :quote_prefix, "Prefijo" %><%= f.text_field :quote_prefix, maxlength: 8, data: { number_preview_target: "prefix", action: "input->number-preview#update" } %></div>
          <div class="field"><%= f.label :quote_number_digits, "Dígitos" %><%= f.number_field :quote_number_digits, min: 3, max: 8, data: { number_preview_target: "digits", action: "input->number-preview#update" } %></div>
          <div class="field"><%= f.label :quote_number_start, "Empezar en" %><%= f.number_field :quote_number_start, min: 1, data: { number_preview_target: "start", action: "input->number-preview#update" } %></div>
          <div class="field"><span class="label">Año</span><label class="check-inline" style="height:40px"><%= f.check_box :quote_number_year, data: { number_preview_target: "year", action: "number-preview#update" } %> Incluir el año</label></div>
        </div>
        <div class="number-sample">Próxima cotización: <strong data-number-preview-target="sample" data-year="<%= Date.current.year %>" data-next="<%= Quote.next_number %>"><%= Quote.next_number %></strong></div>
        <%= field_hint("Se asigna sola al crear cada cotización y no se repite nunca, ni con las que están en la papelera. Con el año incluido, la cuenta vuelve a empezar cada año. «Empezar en» sirve para seguir la numeración que ya usabas.") %>
      </div>
      <div class="field"><%= f.label :request_prefix, "Prefijo de las solicitudes del sitio" %><%= f.text_field :request_prefix, maxlength: 8 %><%= field_hint("Ej.: SOL → SOL-#{Date.current.year}-0001. El cliente lo ve en la confirmación.") %></div>
      <div class="field"><%= f.label :quote_validity_days, "Validez (días)" %><%= f.number_field :quote_validity_days, min: 1 %></div>
      <div class="field span-2"><%= f.label :quote_default_notes, "Notas" %><%= f.text_area :quote_default_notes, rows: 2 %></div>
      <div class="field span-2"><%= f.label :quote_default_terms, "Condiciones" %><%= f.text_area :quote_default_terms, rows: 4 %></div>
      <div class="field span-2"><%= f.label :quote_payment_info, "Forma de pago" %><%= f.text_area :quote_payment_info, rows: 3 %></div>
      <%= image_field(f, :pdf_logo, label: "Logo del PDF (blanco, va sobre la banda oscura)", hint: "PNG transparente. Si no subís uno se usa el logo de la barra o el de toma6.", version: :small, logo: true) %>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><div><h2>Papelera</h2><p>Todo lo que se elimina va primero a la papelera y se puede restaurar.</p></div></div>
    <div class="card-body form-grid">
      <div class="field"><%= f.label :trash_retention_days, "Borrar definitivamente después de (días)" %><%= f.number_field :trash_retention_days, min: 1, max: 365 %></div>
      <div class="field"><span class="label">Última limpieza automática</span><p style="margin:8px 0 0"><%= @setting.last_trash_purge_at ? "#{l(@setting.last_trash_purge_at, format: :long)}" : "Todavía no corrió" %></p>
        <%= field_hint("La limpieza corre todos los días a las 3:00 y borra, con sus archivos, lo que superó los días configurados.") %></div>
    </div>
  </div>

  <div class="sticky-actions"><span class="spacer"></span><button type="submit" class="btn btn-primary"><%= icon(:check, size: 16) %> Guardar ajustes</button></div>
<% end %>

<div class="card" id="cache" style="margin-top:18px">
  <div class="card-head"><div><h2>Caché del sitio</h2><p>Las páginas públicas se guardan ya armadas para que carguen rápido. Se renuevan solas cada vez que guardás un cambio en el panel y en cada actualización del sistema.</p></div></div>
  <div class="card-body form-grid">
    <div class="field"><span class="label">Dónde se guarda</span><p style="margin:8px 0 0"><strong><%= Rails.application.config.action_controller.perform_caching ? CacheStoreConfig.label : "Desactivado" %></strong></p>
      <%= field_hint("Usa Redis si está configurado (REDIS_URL); si no, la memoria del servidor.") %></div>
    <div class="field"><span class="label">Versión del contenido</span><p style="margin:8px 0 0"><strong><%= SiteCache.version %></strong></p>
      <%= field_hint("Sube sola con cada cambio.") %></div>
    <div class="span-2">
      <%= button_to safe_join([icon(:refresh, size: 16), "Vaciar caché ahora"]), clear_cache_admin_settings_path, class: "btn",
                    form: { data: { turbo_confirm: "Las páginas se vuelven a armar en la próxima visita. ¿Continuar?" } } %>
      <%= field_hint("Usalo solo si algo no se actualiza en el sitio (por ejemplo, después de cambiar algo directo en la base).") %>
    </div>
  </div>
</div>
