<% content_for :title, "Usuarios" %>
<%= render "admin/shared/header", title: "Usuarios", subtitle: "Quiénes pueden entrar al panel y qué puede hacer cada uno.",
           actions: link_to(safe_join([icon(:plus, size: 16), "Nuevo usuario"]), new_admin_user_path, class: "btn btn-primary") %>
<div class="card table-wrap">
  <table class="table">
    <thead><tr><th>Persona</th><th>Rol</th><th>Estado</th><th>Último ingreso</th><th></th></tr></thead>
    <tbody>
      <% @records.each do |user| %>
        <tr>
          <td><div style="display:flex;gap:10px;align-items:center"><%= avatar_for(user, size: 32) %><div><%= link_to user.name, edit_admin_user_path(user), class: "row-title" %><span class="row-sub"><%= user.email %></span></div></div></td>
          <td><%= user.role_label %></td>
          <td><%= user.active? ? content_tag(:span, "Activo", class: "badge badge-ok") : content_tag(:span, "Desactivado", class: "badge badge-muted") %></td>
          <td><%= user.last_sign_in_at ? "hace #{time_ago_in_words(user.last_sign_in_at)}" : content_tag(:span, "Nunca", class: "muted") %></td>
          <td class="actions-cell"><%= link_to icon(:edit, size: 16, title: "Editar"), edit_admin_user_path(user), class: "icon-btn" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<%= pagination_nav %>
<div class="card" style="margin-top:18px">
  <div class="card-head"><h2>Qué puede hacer cada rol</h2></div>
  <div class="card-body grid-2">
    <% User::ROLES.each do |key, label| %>
      <div><strong><%= label %></strong><p class="hint" style="margin-top:4px"><%= User::ROLE_DESCRIPTIONS[key] %></p></div>
    <% end %>
  </div>
</div>
