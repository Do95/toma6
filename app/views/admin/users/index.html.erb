<% content_for :title, "Usuarios" %>
<%= render "admin/shared/header", title: "Usuarios", subtitle: "Quiénes pueden entrar al panel y qué puede hacer cada uno. Para sumar a alguien, creá su usuario y le llega una invitación por correo.",
           actions: link_to(safe_join([icon(:plus, size: 16), "Invitar a alguien"]), new_admin_user_path, class: "btn btn-primary") %>
<div class="card table-wrap">
  <table class="table">
    <thead><tr><th>Persona</th><th>Rol</th><th>Estado</th><th>Último ingreso</th><th></th></tr></thead>
    <tbody>
      <% @records.each do |user| %>
        <tr>
          <td><div style="display:flex;gap:10px;align-items:center"><%= avatar_for(user, size: 32) %><div><%= link_to user.name, edit_admin_user_path(user), class: "row-title" %><span class="row-sub"><span class="code-chip"><%= user.code %></span> <%= user.email %></span></div></div></td>
          <td><%= user.role_label %></td>
          <td>
            <% if !user.active? %><span class="badge badge-muted">Desactivado</span>
            <% elsif user.invitation_expired? %><span class="badge badge-red">Invitación vencida</span>
            <% elsif user.invitation_pending? %><span class="badge badge-warn">Invitación pendiente</span>
            <% else %><span class="badge badge-ok">Activo</span><% end %>
          </td>
          <td><%= user.last_sign_in_at ? "hace #{time_ago_in_words(user.last_sign_in_at)}" : content_tag(:span, "Nunca", class: "muted") %></td>
          <td class="actions-cell">
            <% if user.invitation_pending? %>
              <%= button_to icon(:send, size: 16, title: "Reenviar invitación"), invite_admin_user_path(user), class: "icon-btn",
                            form: { data: { turbo_confirm: "¿Reenviar la invitación a #{user.email}? El enlace anterior deja de funcionar." } } %>
            <% end %>
            <%= link_to icon(:edit, size: 16, title: "Editar"), edit_admin_user_path(user), class: "icon-btn" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<%= pagination_nav %>
<div class="card" style="margin-top:18px">
  <div class="card-head"><h2>Qué puede hacer cada rol</h2></div>
  <div class="card-body grid-2">
    <% User::ROLES.each do |key, label| %>
      <div><strong><%= label %></strong><p class="hint" style="margin-top:4px"><%= User::ROLE_DESCRIPTIONS[key] %></p></div>
    <% end %>
  </div>
</div>
