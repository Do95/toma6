# Base de datos
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=postgres
# En producción podés usar una sola URL:
# DATABASE_URL=postgres://usuario:clave@host:5432/toma6_production

# Dominio público (necesario para Instagram, correos y el PDF)
APP_HOST=www.toma6.com
APP_PROTOCOL=https

# Usuario administrador inicial (lo crea bin/rails db:seed)
ADMIN_EMAIL=admin@toma6.com
ADMIN_PASSWORD=cambiame-ya-123

# Cifrado de tokens de Facebook/Instagram (bin/rails db:encryption:init)
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# Correo saliente (cotizaciones y avisos de solicitudes)
SMTP_ADDRESS=smtp.hostinger.com
SMTP_PORT=587
SMTP_USERNAME=hola@toma6.com
SMTP_PASSWORD=
MAIL_FROM="toma6 <hola@toma6.com>"

# Rails
SECRET_KEY_BASE=
RAILS_ENV=production
RAILS_SERVE_STATIC_FILES=true

# Fotos en S3 / Cloudflare R2 / DigitalOcean Spaces. Obligatorio en producción
# (ver README → «Fotos en S3»). En desarrollo, sin S3_BUCKET, se guardan en public/uploads.
# Para un VPS que guarda en su propio disco: UPLOADS_STORAGE=local
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# Solo para R2 / Spaces / B2:
S3_ENDPOINT=
S3_PATH_STYLE=false
# Opcional: dominio público o CDN del bucket
S3_PUBLIC_URL=
# Solo si el bucket usa ACL en lugar de política pública:
# S3_OBJECT_ACL=public-read

# Tareas en segundo plano con GoodJob (purga automática de la papelera, posts programados).
# En "false" los correos se envían igual (en memoria) y las tareas programadas se corren con:
#   bin/rails trash:purge            (una vez por día)
#   bin/rails social:publish_scheduled  (cada 10 minutos)
JOBS_ENABLED=false

# Anti-spam (opcional): captcha de Cloudflare Turnstile en el cotizador.
# Sin estas claves igual hay campo trampa, tiempo mínimo, límites por IP/correo y filtros de contenido.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
